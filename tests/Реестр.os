#Использовать ".."
#Использовать asserts

// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

// -----------------------------------------------------------------------------
// Тесты реестра CollectorRegistry: повторная регистрация и метрики с одним именем.
// Метрики с одним именем выводятся одним семейством, поэтому регистрируются только
// метрики одного типа с разными константными лейблами.
// -----------------------------------------------------------------------------

// Register отклоняет тот же коллектор, метрику с тем же именем и такими же константными лейблами
// и метрику с тем же именем другого типа. Метрика того же типа с другими константными лейблами
// регистрируется.
&Тест
Процедура ТестДолжен_РеестрОтклоняетКонфликтующиеМетрики() Экспорт
	Реестр = Новый CollectorRegistry;
	Счетчик = СчетчикСЛейблом("jobs_total", "queue", "fast");

	Утверждения.ПроверитьИстину(Реестр.Register(Счетчик), "Первая регистрация");
	Утверждения.ПроверитьЛожь(Реестр.Register(Счетчик), "Тот же коллектор");
	Утверждения.ПроверитьЛожь(
		Реестр.Register(СчетчикСЛейблом("jobs_total", "queue", "fast")),
		"То же имя и те же константные лейблы");
	Утверждения.ПроверитьЛожь(
		Реестр.Register(ИндикаторСЛейблом("jobs_total", "queue", "slow")),
		"То же имя и другой тип");
	Утверждения.ПроверитьИстину(
		Реестр.Register(СчетчикСЛейблом("jobs_total", "queue", "slow")),
		"То же имя и другие константные лейблы");
КонецПроцедуры

// Счётчики с одним именем и разными константными лейблами собираются в одно семейство, и в тексте
// есть обе серии: сериализатор из семейств с одним именем выводит только последнее.
&Тест
Процедура ТестДолжен_РеестрОбъединяетСемействаСОднимИменем() Экспорт
	Реестр = Новый CollectorRegistry;
	Быстрая = СчетчикСЛейблом("queue_jobs_total", "queue", "fast");
	Медленная = СчетчикСЛейблом("queue_jobs_total", "queue", "slow");
	PrometheusMetrics.ДобавитьКСчетчику(Быстрая, 5);
	PrometheusMetrics.ДобавитьКСчетчику(Медленная, 7);
	Реестр.Register(Быстрая);
	Реестр.Register(Медленная);

	Семейства = Реестр.Gather();

	Утверждения.ПроверитьРавенство(1, Семейства.Количество(), "Одно семейство queue_jobs_total");
	Утверждения.ПроверитьРавенство(
		"# TYPE queue_jobs_total counter" + Символы.ПС
			+ "queue_jobs_total{queue=""fast""} 5" + Символы.ПС
			+ "queue_jobs_total{queue=""slow""} 7" + Символы.ПС,
		PrometheusTextFormat.Сериализовать(Семейства),
		"Обе серии в тексте");
КонецПроцедуры

// Фасад при повторном создании метрики с тем же именем вызывает исключение с именем метрики,
// а не регистрирует вторую метрику, значения которой пропали бы из выдачи.
&Тест
Процедура ТестДолжен_ФасадИсключениеПриПовторномИмениМетрики() Экспорт
	Prometheus.НовыйСчетчик("facade_duplicate_total", "Дубль");

	ТекстОшибки = "";
	Попытка
		Prometheus.НовыйСчетчик("facade_duplicate_total", "Дубль");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Утверждения.ПроверитьИстину(
		СтрНайти(ТекстОшибки, "facade_duplicate_total") > 0,
		"Исключение с именем метрики, получено: " + ТекстОшибки);
КонецПроцедуры

Функция СчетчикСЛейблом(Имя, ИмяЛейбла, ЗначениеЛейбла)
	Возврат PrometheusMetrics.НовыйСчетчик(ОпцииСЛейблом(Имя, ИмяЛейбла, ЗначениеЛейбла));
КонецФункции

Функция ИндикаторСЛейблом(Имя, ИмяЛейбла, ЗначениеЛейбла)
	Возврат PrometheusMetrics.НовыйИндикатор(ОпцииСЛейблом(Имя, ИмяЛейбла, ЗначениеЛейбла));
КонецФункции

Функция ОпцииСЛейблом(Имя, ИмяЛейбла, ЗначениеЛейбла)
	Лейблы = Новый Соответствие;
	Лейблы.Вставить(ИмяЛейбла, ЗначениеЛейбла);

	Возврат Новый Структура("Имя, КонстантныеЛейблы", Имя, Лейблы);
КонецФункции
