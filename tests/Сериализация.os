#Использовать ".."
#Использовать asserts

// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

// -----------------------------------------------------------------------------
// Тесты сериализации в Prometheus text format: массив семейств → строка с
// # HELP, # TYPE, строками метрик; Content-Type для HTTP-ответа.
// -----------------------------------------------------------------------------

// Вручную формируем одно семейство с одним сэмплом (counter с лейблами).
// Сериализатор должен выдать # HELP, # TYPE, строку с метрикой и значением 42.
// Content-Type должен содержать text/plain и version 0.0.4.
&Тест
Процедура ТестДолжен_СериализацияСемействаВТекстИContentType() Экспорт
	Лейблы = Новый Соответствие;
	Лейблы.Вставить("method", "get");
	Лейблы.Вставить("code", "200");

	Сэмпл = Новый Структура(
		"ИмяСэмпла, Лейблы, Значение",
		"http_requests_total", Лейблы, 42);
	Семейство = Новый Структура;
	Семейство.Вставить("Имя", "http_requests_total");
	Семейство.Вставить("Тип", "counter");
	Семейство.Вставить("Справка", "Всего запросов");
	Семейство.Вставить("Сэмплы", Новый Массив);
	Семейство.Сэмплы.Добавить(Сэмпл);

	Семейства = Новый Массив;
	Семейства.Добавить(Семейство);

	Текст = PrometheusTextFormat.Сериализовать(Семейства);

	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "# HELP http_requests_total") > 0,
		"Ожидалась строка # HELP http_requests_total");
	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "# TYPE http_requests_total counter") > 0,
		"Ожидалась строка # TYPE http_requests_total counter");
	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "http_requests_total{") > 0,
		"Ожидалась строка с метрикой и лейблами");
	Утверждения.ПроверитьИстину(СтрНайти(Текст, "42") > 0, "Ожидалось значение 42 в тексте");

	ТипКонтента = PrometheusTextFormat.ContentType();

	Утверждения.ПроверитьИстину(
		СтрНайти(ТипКонтента, "text/plain") > 0 И СтрНайти(ТипКонтента, "0.0.4") > 0,
		"Content-Type должен содержать text/plain и version 0.0.4");
КонецПроцедуры

// Гистограмма с одной серией. Границы le заданы строками, как их формирует
// PrometheusMetrics, и переданы не по порядку. В тексте должны остаться все бакеты
// по возрастанию le, затем +Inf, _sum и _count.
&Тест
Процедура ТестДолжен_СериализацияГистограммыСохраняетВсеБакеты() Экспорт
	Сэмплы = Новый Массив;
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "1", 3));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "0.1", 1));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "+Inf", 3));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "0.5", 2));
	Сэмплы.Добавить(СэмплГистограммы("lat_sum", Неопределено, 0.95));
	Сэмплы.Добавить(СэмплГистограммы("lat_count", Неопределено, 3));

	Строки = СтрокиСэмплов(PrometheusTextFormat.Сериализовать(СемействаИзСэмплов("lat", "histogram", Сэмплы)));

	Ожидаемые = Новый Массив;
	Ожидаемые.Добавить("lat_bucket{le=""0.1""} 1");
	Ожидаемые.Добавить("lat_bucket{le=""0.5""} 2");
	Ожидаемые.Добавить("lat_bucket{le=""1""} 3");
	Ожидаемые.Добавить("lat_bucket{le=""+Inf""} 3");
	Ожидаемые.Добавить("lat_sum 0.95");
	Ожидаемые.Добавить("lat_count 3");
	Утверждения.ПроверитьРавенство(
		СтрСоединить(Ожидаемые, Символы.ПС), СтрСоединить(Строки, Символы.ПС),
		"Все бакеты гистограммы по возрастанию le, затем _sum и _count");
КонецПроцедуры

// Гистограмма с двумя сериями (method=GET и method=POST), сэмплы серий перемешаны.
// Каждая серия выводится целиком и подряд: бакеты по возрастанию le, +Inf, _sum, _count.
&Тест
Процедура ТестДолжен_СериализацияГистограммыСохраняетВсеСерии() Экспорт
	Сэмплы = Новый Массив;
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "0.5", 1, "GET"));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "0.5", 0, "POST"));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "+Inf", 1, "GET"));
	Сэмплы.Добавить(СэмплГистограммы("lat_bucket", "+Inf", 2, "POST"));
	Сэмплы.Добавить(СэмплГистограммы("lat_sum", Неопределено, 0.2, "GET"));
	Сэмплы.Добавить(СэмплГистограммы("lat_sum", Неопределено, 1.5, "POST"));
	Сэмплы.Добавить(СэмплГистограммы("lat_count", Неопределено, 1, "GET"));
	Сэмплы.Добавить(СэмплГистограммы("lat_count", Неопределено, 2, "POST"));

	Строки = СтрокиСэмплов(PrometheusTextFormat.Сериализовать(СемействаИзСэмплов("lat", "histogram", Сэмплы)));

	ОжидаемыеGET = Новый Массив;
	ОжидаемыеGET.Добавить("lat_bucket{le=""0.5"",method=""GET""} 1");
	ОжидаемыеGET.Добавить("lat_bucket{le=""+Inf"",method=""GET""} 1");
	ОжидаемыеGET.Добавить("lat_sum{method=""GET""} 0.2");
	ОжидаемыеGET.Добавить("lat_count{method=""GET""} 1");
	ОжидаемыеPOST = Новый Массив;
	ОжидаемыеPOST.Добавить("lat_bucket{le=""0.5"",method=""POST""} 0");
	ОжидаемыеPOST.Добавить("lat_bucket{le=""+Inf"",method=""POST""} 2");
	ОжидаемыеPOST.Добавить("lat_sum{method=""POST""} 1.5");
	ОжидаемыеPOST.Добавить("lat_count{method=""POST""} 2");
	Утверждения.ПроверитьРавенство(8, Строки.Количество(), "Количество строк сэмплов двух серий");
	ПроверитьСериюПодряд(Строки, ОжидаемыеGET, "Серия GET");
	ПроверитьСериюПодряд(Строки, ОжидаемыеPOST, "Серия POST");
КонецПроцедуры

// Резюме с двумя сериями (method=GET и method=POST). Каждая серия выводится целиком
// и подряд: квантили по возрастанию, затем _sum и _count.
&Тест
Процедура ТестДолжен_СериализацияРезюмеСохраняетВсеСерии() Экспорт
	Сэмплы = Новый Массив;
	Сэмплы.Добавить(СэмплРезюме("rpc", 0.9, 1, "GET"));
	Сэмплы.Добавить(СэмплРезюме("rpc", 0.5, 1, "GET"));
	Сэмплы.Добавить(СэмплРезюме("rpc_sum", Неопределено, 1, "GET"));
	Сэмплы.Добавить(СэмплРезюме("rpc_count", Неопределено, 1, "GET"));
	Сэмплы.Добавить(СэмплРезюме("rpc", 0.5, 5, "POST"));
	Сэмплы.Добавить(СэмплРезюме("rpc", 0.9, 7, "POST"));
	Сэмплы.Добавить(СэмплРезюме("rpc_sum", Неопределено, 12, "POST"));
	Сэмплы.Добавить(СэмплРезюме("rpc_count", Неопределено, 2, "POST"));

	Строки = СтрокиСэмплов(PrometheusTextFormat.Сериализовать(СемействаИзСэмплов("rpc", "summary", Сэмплы)));

	ОжидаемыеGET = Новый Массив;
	ОжидаемыеGET.Добавить("rpc{method=""GET"",quantile=""0.5""} 1");
	ОжидаемыеGET.Добавить("rpc{method=""GET"",quantile=""0.9""} 1");
	ОжидаемыеGET.Добавить("rpc_sum{method=""GET""} 1");
	ОжидаемыеGET.Добавить("rpc_count{method=""GET""} 1");
	ОжидаемыеPOST = Новый Массив;
	ОжидаемыеPOST.Добавить("rpc{method=""POST"",quantile=""0.5""} 5");
	ОжидаемыеPOST.Добавить("rpc{method=""POST"",quantile=""0.9""} 7");
	ОжидаемыеPOST.Добавить("rpc_sum{method=""POST""} 12");
	ОжидаемыеPOST.Добавить("rpc_count{method=""POST""} 2");
	Утверждения.ПроверитьРавенство(8, Строки.Количество(), "Количество строк сэмплов двух серий");
	ПроверитьСериюПодряд(Строки, ОжидаемыеGET, "Серия GET");
	ПроверитьСериюПодряд(Строки, ОжидаемыеPOST, "Серия POST");
КонецПроцедуры

Функция СэмплГистограммы(ИмяСэмпла, Ле, Значение, Метод = Неопределено)
	Лейблы = Новый Соответствие;
	Если Метод <> Неопределено Тогда
		Лейблы.Вставить("method", Метод);
	КонецЕсли;
	Если Ле <> Неопределено Тогда
		Лейблы.Вставить("le", Ле);
	КонецЕсли;
	Возврат Новый Структура("ИмяСэмпла, Лейблы, Значение", ИмяСэмпла, Лейблы, Значение);
КонецФункции

Функция СэмплРезюме(ИмяСэмпла, Квантиль, Значение, Метод)
	Лейблы = Новый Соответствие;
	Лейблы.Вставить("method", Метод);
	Сэмпл = Новый Структура("ИмяСэмпла, Лейблы, Значение", ИмяСэмпла, Лейблы, Значение);
	Если Квантиль <> Неопределено Тогда
		Лейблы.Вставить("quantile", Строка(Квантиль));
		Сэмпл.Вставить("Квантиль", Квантиль);
	КонецЕсли;
	Возврат Сэмпл;
КонецФункции

Функция СемействаИзСэмплов(Имя, Тип, Сэмплы)
	Семейство = Новый Структура;
	Семейство.Вставить("Имя", Имя);
	Семейство.Вставить("Тип", Тип);
	Семейство.Вставить("Справка", "");
	Семейство.Вставить("Сэмплы", Сэмплы);
	Семейства = Новый Массив;
	Семейства.Добавить(Семейство);
	Возврат Семейства;
КонецФункции

// Возвращает строки текста без комментариев # HELP и # TYPE.
//
// Параметры:
//   Текст - Строка - результат PrometheusTextFormat.Сериализовать.
//
// Возвращаемое значение:
//   Массив из Строка - строки сэмплов.
Функция СтрокиСэмплов(Текст)
	Результат = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если НЕ СтрНачинаетсяС(Строка, "#") Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверяет, что ожидаемые строки серии есть в тексте и идут подряд в указанном порядке.
//
// Параметры:
//   Строки - Массив из Строка - строки сэмплов.
//   Ожидаемые - Массив из Строка - строки серии в ожидаемом порядке.
//   Описание - Строка - название серии для сообщений.
Процедура ПроверитьСериюПодряд(Строки, Ожидаемые, Описание)
	Начало = Строки.Найти(Ожидаемые[0]);
	Утверждения.ПроверитьИстину(Начало <> Неопределено, Описание + ": нет строки " + Ожидаемые[0]);
	Для Индекс = 1 По Ожидаемые.ВГраница() Цикл
		Позиция = Начало + Индекс;
		Фактическая = ?(Позиция <= Строки.ВГраница(), Строки[Позиция], "<конец текста>");
		Утверждения.ПроверитьРавенство(Ожидаемые[Индекс], Фактическая,
			Описание + ": строка " + (Индекс + 1));
	КонецЦикла;
КонецПроцедуры
