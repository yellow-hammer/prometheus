#Использовать ".."
#Использовать asserts

// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

// -----------------------------------------------------------------------------
// Тесты гистограммы (Histogram) и резюме (Summary).
// Гистограмма: бакеты с верхними границами, Observe; при сборе - _bucket, _sum, _count.
// Резюме: квантили, Observe; при сборе - сэмплы с quantile, _sum, _count.
// -----------------------------------------------------------------------------

// Гистограмма: задаём границы бакетов, вызываем Observe для нескольких значений.
// При сборе должны появиться сэмплы с суффиксами _bucket, _sum, _count; _count = 3.
&Тест
Процедура ТестДолжен_ГистограммаНаблюдениеИБакетыПриСборе() Экспорт
	Границы = Новый Массив;
	Границы.Добавить(0.1);
	Границы.Добавить(0.5);
	Границы.Добавить(1);
	Опции = Новый Структура(
		"Имя, Справка, ВерхниеГраницыБакетов",
		"request_duration_seconds", "Длительность запроса", Границы);
	Гистограмма = PrometheusMetrics.НоваяГистограмма(Опции);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.05);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.2);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.7);

	PrometheusRegistry.ЗарегистрироватьОбязательно(Гистограмма);
	Семейства = PrometheusRegistry.Собрать();

	ЕстьBucket = Ложь;
	ЕстьSum = Ложь;
	ЕстьCount = Ложь;
	ЗначениеCount = 0;
	Для Каждого Семейство Из Семейства Цикл
		Если Семейство.Имя = "request_duration_seconds" Тогда
			Для Каждого Сэмпл Из Семейство.Сэмплы Цикл
				Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_bucket") Тогда
					ЕстьBucket = Истина;
				КонецЕсли;

				Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_sum") Тогда
					ЕстьSum = Истина;
				КонецЕсли;

				Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_count") Тогда
					ЕстьCount = Истина;
					ЗначениеCount = Сэмпл.Значение;
				КонецЕсли;
			КонецЦикла;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Утверждения.ПроверитьИстину(
		ЕстьBucket И ЕстьSum И ЕстьCount,
		"В гистограмме должны быть _bucket, _sum, _count");
	Утверждения.ПроверитьРавенство(3, ЗначениеCount, "_count должен быть 3");
КонецПроцедуры

// Гистограмма: границы 0.1, 0.5, 1 и наблюдения 0.05, 0.2, 0.7.
// Бакет le считает наблюдения <= le один раз: 1, 2, 3; +Inf = _count = 3.
// Ни один бакет не может быть больше _count.
&Тест
Процедура ТестДолжен_ГистограммаЗначенияБакетовНакопленыОдинРаз() Экспорт
	Границы = Новый Массив;
	Границы.Добавить(0.1);
	Границы.Добавить(0.5);
	Границы.Добавить(1);
	Опции = Новый Структура(
		"Имя, Справка, ВерхниеГраницыБакетов",
		"bucket_values_seconds", "Длительность", Границы);
	Гистограмма = PrometheusMetrics.НоваяГистограмма(Опции);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.05);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.2);
	PrometheusMetrics.НаблюдатьГистограмму(Гистограмма, 0.7);

	Реестр = Новый CollectorRegistry;
	Реестр.Register(Гистограмма);
	Семейства = Реестр.Gather();

	ЗначенияБакетов = Новый Соответствие;
	Для Каждого Сэмпл Из Семейства[0].Сэмплы Цикл
		Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_bucket") Тогда
			ЗначенияБакетов.Вставить(Сэмпл.Лейблы.Получить("le"), Сэмпл.Значение);
		КонецЕсли;
	КонецЦикла;

	Утверждения.ПроверитьРавенство(1, ЗначенияБакетов.Получить("0.1"), "Бакет le=0.1");
	Утверждения.ПроверитьРавенство(2, ЗначенияБакетов.Получить("0.5"), "Бакет le=0.5");
	Утверждения.ПроверитьРавенство(3, ЗначенияБакетов.Получить("1"), "Бакет le=1");
	Утверждения.ПроверитьРавенство(3, ЗначенияБакетов.Получить("+Inf"), "Бакет le=+Inf");
КонецПроцедуры

// Резюме: задаём квантили 0.5 и 0.9, три наблюдения (100, 200, 300).
// При сборе: сэмплы с quantile, _count = 3, _sum = 600.
// Имя метрики уникально, чтобы не пересекаться с response_size_bytes из других тестов.
&Тест
Процедура ТестДолжен_РезюмеНаблюдениеИКвантилиПриСборе() Экспорт
	Квантили = Новый Массив;
	Квантили.Добавить(0.5);
	Квантили.Добавить(0.9);

	ИмяМетрики = "summary_three_observations";
	Опции = Новый Структура(
		"Имя, Справка, Квантили",
		ИмяМетрики, "Размер ответа", Квантили);
	Резюме = PrometheusMetrics.НовоеРезюме(Опции);

	PrometheusMetrics.НаблюдатьРезюме(Резюме, 100);
	PrometheusMetrics.НаблюдатьРезюме(Резюме, 200);
	PrometheusMetrics.НаблюдатьРезюме(Резюме, 300);

	PrometheusRegistry.ЗарегистрироватьОбязательно(Резюме);
	Семейства = PrometheusRegistry.Собрать();

	ЕстьCount = Ложь;
	ЕстьSum = Ложь;
	ЕстьQuantile = Ложь;
	ЗначениеCount = 0;
	ЗначениеSum = 0;

	Для Каждого Семейство Из Семейства Цикл
		Если Семейство.Имя = ИмяМетрики Тогда
			Для Каждого Сэмпл Из Семейство.Сэмплы Цикл
				Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_count") Тогда
					ЕстьCount = Истина;
					ЗначениеCount = Сэмпл.Значение;
				КонецЕсли;

				Если СтрЗаканчиваетсяНа(Сэмпл.ИмяСэмпла, "_sum") Тогда
					ЕстьSum = Истина;
					ЗначениеSum = Сэмпл.Значение;
				КонецЕсли;

				Если Сэмпл.Свойство("Квантиль") Тогда
					ЕстьQuantile = Истина;
				КонецЕсли;
			КонецЦикла;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Утверждения.ПроверитьИстину(
		ЕстьCount И ЕстьSum И ЕстьQuantile,
		"В summary должны быть _count, _sum и сэмплы с quantile");
	Утверждения.ПроверитьРавенство(3, ЗначениеCount, "_count должен быть 3");
	Утверждения.ПроверитьРавенство(600, ЗначениеSum, "_sum должен быть 600");
КонецПроцедуры

// Резюме с окном из трёх наблюдений получает наблюдения 1..5. _count, как и _sum, считает
// все пять наблюдений; окно ограничивает только выборку для квантилей (3, 4, 5).
&Тест
Процедура ТестДолжен_РезюмеCountСчитаетНаблюденияЗаПределамиОкна() Экспорт
	Квантили = Новый Массив;
	Квантили.Добавить(0.5);
	Опции = Новый Структура("Имя, Справка, Квантили", "window_summary", "Окно", Квантили);
	Резюме = PrometheusMetrics.НовоеРезюме(Опции);
	Резюме.МаксНаблюдений = 3;
	Для Значение = 1 По 5 Цикл
		PrometheusMetrics.НаблюдатьРезюме(Резюме, Значение);
	КонецЦикла;

	Реестр = Новый CollectorRegistry;
	Реестр.Register(Резюме);
	Текст = PrometheusTextFormat.Сериализовать(Реестр.Gather());

	Утверждения.ПроверитьРавенство(
		"# HELP window_summary Окно" + Символы.ПС
			+ "# TYPE window_summary summary" + Символы.ПС
			+ "window_summary{quantile=""0.5""} 4" + Символы.ПС
			+ "window_summary_sum 15" + Символы.ПС
			+ "window_summary_count 5" + Символы.ПС,
		Текст,
		"_sum и _count за все наблюдения, квантиль по окну");
КонецПроцедуры

// Фасад и вектор без явных квантилей получают квантили по умолчанию 0.5, 0.9, 0.99, как
// PrometheusMetrics.НовоеРезюме. Явный пустой массив оставляет резюме без квантилей.
&Тест
Процедура ТестДолжен_РезюмеФасадаИВектораСКвантилямиПоУмолчанию() Экспорт
	ИменаЛейблов = Новый Массив;
	ИменаЛейблов.Добавить("handler");
	ЗначенияЛейблов = Новый Массив;
	ЗначенияЛейблов.Добавить("index");

	Резюме = Prometheus.НовоеРезюме("default_quantiles_summary", "Квантили по умолчанию");
	Вектор = Prometheus.НовоеРезюмеВектор("default_quantiles_summary_vec", "Квантили по умолчанию", ИменаЛейблов);
	ИзВектора = Prometheus.РезюмеСЛейблами(Вектор, ЗначенияЛейблов);
	БезКвантилей = Prometheus.НовоеРезюме("no_quantiles_summary", "Без квантилей", Новый Массив);

	Утверждения.ПроверитьРавенство("0.5, 0.9, 0.99", КвантилиСтрокой(Резюме), "Квантили резюме фасада");
	Утверждения.ПроверитьРавенство("0.5, 0.9, 0.99", КвантилиСтрокой(ИзВектора), "Квантили резюме из вектора");
	Утверждения.ПроверитьРавенство("", КвантилиСтрокой(БезКвантилей), "Явный пустой массив квантилей");
КонецПроцедуры

Функция КвантилиСтрокой(Резюме)
	Части = Новый Массив;
	Для Каждого Квантиль Из Резюме.Квантили Цикл
		Части.Добавить(Строка(Квантиль));
	КонецЦикла;

	Возврат СтрСоединить(Части, ", ");
КонецФункции
