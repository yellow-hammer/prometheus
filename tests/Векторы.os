#Использовать ".."
#Использовать asserts

// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

// -----------------------------------------------------------------------------
// Тесты векторных метрик (CounterVec, GaugeVec): получение экземпляра по лейблам,
// изменение значений, удаление одной серии (Remove), очистка всех (Clear).
// При сборе после Remove остаётся только одна серия; после Clear - ноль сэмплов.
// -----------------------------------------------------------------------------

// CounterVec: два набора лейблов (GET/200 и POST/201), инкремент и Add.
// Удаляем серию POST/201; при сборе у http_requests_total должен остаться один сэмпл.
// GaugeVec: одна серия (queue=default), Set; затем Clear - при сборе у queue_size 0 сэмплов.
&Тест
Процедура ТестДолжен_ВекторыЛейблыУдалениеСерииИОчистка() Экспорт
	ИменаЛейблов = Новый Массив;
	ИменаЛейблов.Добавить("method");
	ИменаЛейблов.Добавить("code");
	ОпцииСчетчик = Новый Структура(
		"Имя, Справка, ИменаПеременныхЛейблов",
		"http_requests_total", "Запросы по методу и коду", ИменаЛейблов);
	ВекторСчетчик = PrometheusVec.НовыйСчетчикВектор(ОпцииСчетчик);

	ЗначенияМетокGET = Новый Массив;
	ЗначенияМетокGET.Добавить("GET");
	ЗначенияМетокGET.Добавить("200");
	СчетчикGET = PrometheusVec.СчетчикВекторСМетками(ВекторСчетчик, ЗначенияМетокGET);
	PrometheusMetrics.ИнкрементСчетчика(СчетчикGET);

	ЗначенияМетокPOST = Новый Массив;
	ЗначенияМетокPOST.Добавить("POST");
	ЗначенияМетокPOST.Добавить("201");
	СчетчикPOST = PrometheusVec.СчетчикВекторСМетками(ВекторСчетчик, ЗначенияМетокPOST);
	PrometheusMetrics.ДобавитьКСчетчику(СчетчикPOST, 2);
	PrometheusVec.ВекторУдалить(ВекторСчетчик, ЗначенияМетокPOST);
	PrometheusRegistry.ЗарегистрироватьОбязательно(ВекторСчетчик);

	ИменаОчереди = Новый Массив;
	ИменаОчереди.Добавить("queue");
	ОпцииИндикатор = Новый Структура(
		"Имя, Справка, ИменаПеременныхЛейблов",
		"queue_size", "Размер очереди", ИменаОчереди);
	ВекторИндикатор = PrometheusVec.НовыйИндикаторВектор(ОпцииИндикатор);

	ЗначенияДефолт = Новый Массив;
	ЗначенияДефолт.Добавить("default");
	ИндикаторДефолт = PrometheusVec.ИндикаторВекторСМетками(ВекторИндикатор, ЗначенияДефолт);
	PrometheusMetrics.УстановитьИндикатор(ИндикаторДефолт, 10);
	PrometheusVec.ВекторОчистить(ВекторИндикатор);
	PrometheusRegistry.ЗарегистрироватьОбязательно(ВекторИндикатор);

	Семейства = PrometheusRegistry.Собрать();

	СчетчикСэмплов = 0;
	Для Каждого Семейство Из Семейства Цикл
		Если Семейство.Имя = "http_requests_total" Тогда
			СчетчикСэмплов = Семейство.Сэмплы.Количество();
		КонецЕсли;

		Если Семейство.Имя = "queue_size" Тогда
			Утверждения.ПроверитьРавенство(
				0, Семейство.Сэмплы.Количество(),
				"После Clear у queue_size должно быть 0 сэмплов");
		КонецЕсли;
	КонецЦикла;

	Утверждения.ПроверитьИстину(
		СчетчикСэмплов = 1,
		"После Remove у http_requests_total должен быть один сэмпл (GET/200)");
КонецПроцедуры

// Вектор с лейблами method и code получает лейблы соответствием, в котором одного лейбла нет.
// Недостающий лейбл должен быть пустым, а не повторять значение предыдущего лейбла.
&Тест
Процедура ТестДолжен_ВекторНедостающийЛейблСоответствияПустой() Экспорт
	Вектор = СчетчикВекторСДвумяЛейблами("map_labels_total", "method", "code");
	ЛейблыGET = Новый Соответствие;
	ЛейблыGET.Вставить("method", "GET");
	Лейблы200 = Новый Соответствие;
	Лейблы200.Вставить("code", "200");
	PrometheusMetrics.ИнкрементСчетчика(PrometheusVec.СчетчикВекторСМетками(Вектор, ЛейблыGET));
	PrometheusMetrics.ИнкрементСчетчика(PrometheusVec.СчетчикВекторСМетками(Вектор, Лейблы200));

	Текст = ТекстВектора(Вектор);

	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "map_labels_total{code="""",method=""GET""} 1") > 0,
		"Лейбл code без значения должен быть пустым: " + Текст);
	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "map_labels_total{code=""200"",method=""""} 1") > 0,
		"Лейбл method без значения должен быть пустым: " + Текст);
КонецПроцедуры

// Значения лейблов с символом "|": ("x|y", "z") и ("x", "y|z") - разные серии со своими значениями,
// а не один экземпляр с суммой инкрементов.
&Тест
Процедура ТестДолжен_ВекторЗначенияСРазделителемДаютРазныеСерии() Экспорт
	Вектор = СчетчикВекторСДвумяЛейблами("route_parts_total", "a", "b");
	Первый = PrometheusVec.СчетчикВекторСМетками(Вектор, МассивЗначений("x|y", "z"));
	Второй = PrometheusVec.СчетчикВекторСМетками(Вектор, МассивЗначений("x", "y|z"));
	PrometheusMetrics.ИнкрементСчетчика(Первый);
	PrometheusMetrics.ДобавитьКСчетчику(Второй, 10);

	Текст = ТекстВектора(Вектор);

	Утверждения.ПроверитьИстину(Первый <> Второй, "Разные значения лейблов - разные экземпляры");
	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "route_parts_total{a=""x|y"",b=""z""} 1") > 0,
		"Серия (x|y, z): " + Текст);
	Утверждения.ПроверитьИстину(
		СтрНайти(Текст, "route_parts_total{a=""x"",b=""y|z""} 10") > 0,
		"Серия (x, y|z): " + Текст);
КонецПроцедуры

// Недостающие значения лейблов пустые, лишние отбрасываются: ("GET"), ("GET", "") и
// ("GET", "", "лишнее") - один экземпляр, а не три серии с одинаковыми лейблами.
&Тест
Процедура ТестДолжен_ВекторЛишниеИНедостающиеЗначенияНеДублируютСерии() Экспорт
	Вектор = СчетчикВекторСДвумяЛейблами("label_count_total", "method", "code");
	PrometheusMetrics.ИнкрементСчетчика(PrometheusVec.СчетчикВекторСМетками(Вектор, МассивЗначений("GET")));
	PrometheusMetrics.ИнкрементСчетчика(PrometheusVec.СчетчикВекторСМетками(Вектор, МассивЗначений("GET", "")));
	PrometheusMetrics.ИнкрементСчетчика(
		PrometheusVec.СчетчикВекторСМетками(Вектор, МассивЗначений("GET", "", "лишнее")));

	Текст = ТекстВектора(Вектор);

	Утверждения.ПроверитьРавенство(
		"# TYPE label_count_total counter" + Символы.ПС
			+ "label_count_total{code="""",method=""GET""} 3" + Символы.ПС,
		Текст,
		"Одна серия со всеми инкрементами");
КонецПроцедуры

Функция СчетчикВекторСДвумяЛейблами(Имя, ПервыйЛейбл, ВторойЛейбл)
	ИменаЛейблов = Новый Массив;
	ИменаЛейблов.Добавить(ПервыйЛейбл);
	ИменаЛейблов.Добавить(ВторойЛейбл);
	Опции = Новый Структура("Имя, Справка, ИменаПеременныхЛейблов", Имя, "", ИменаЛейблов);

	Возврат PrometheusVec.НовыйСчетчикВектор(Опции);
КонецФункции

Функция МассивЗначений(Первое, Второе = Неопределено, Третье = Неопределено)
	Значения = Новый Массив;
	Значения.Добавить(Первое);
	Если Второе <> Неопределено Тогда
		Значения.Добавить(Второе);
	КонецЕсли;

	Если Третье <> Неопределено Тогда
		Значения.Добавить(Третье);
	КонецЕсли;

	Возврат Значения;
КонецФункции

Функция ТекстВектора(Вектор)
	Реестр = Новый CollectorRegistry;
	Реестр.Register(Вектор);

	Возврат PrometheusTextFormat.Сериализовать(Реестр.Gather());
КонецФункции
