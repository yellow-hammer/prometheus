// Сериализация в Prometheus text format и OpenMetrics (промежуточный формат: массив семейств -> строка)
// и выбор формата выдачи по заголовку Accept (Prometheus Content Negotiation).

// Код символа перевода строки (LF) для экранирования в лейблах и склейки вывода.
Перем КодСимволаПереводСтроки;
// Экранированные имена метрик и лейблов на время одной сериализации: имена лейблов повторяются
// в каждом сэмпле, а посимвольная проверка имени дорогая.
Перем КэшИмен;

// Возвращает формат выдачи по умолчанию: text 0.0.4 со схемой экранирования underscores.
// Используется, если заголовка Accept нет или ни один запрошенный формат не поддерживается.
//
// Возвращаемое значение:
//   Структура - формат выдачи (см. ВыбратьФормат).
Функция ФорматПоУмолчанию() Экспорт
	Возврат НовыйФормат("text", "0.0.4", "underscores");
КонецФункции

// Выбирает формат выдачи по заголовку Accept: из поддерживаемых форматов (text 0.0.4 и 1.0.0,
// OpenMetrics 0.0.1 и 1.0.0) берется формат с наибольшим весом q, при равных весах - указанный
// раньше. Параметр escaping задает схему экранирования имен (underscores, dots, values,
// allow-utf-8); allow-utf-8 допустим только в форматах версии 1.0.0.
//
// Параметры:
//   Accept - Строка, Неопределено - значение заголовка Accept HTTP-запроса.
//
// Возвращаемое значение:
//   Структура - формат выдачи:
//     * Тип - Строка - "text" или "openmetrics";
//     * Версия - Строка - версия формата;
//     * Экранирование - Строка - схема экранирования имен;
//     * ТипКонтента - Строка - значение заголовка Content-Type ответа.
Функция ВыбратьФормат(Accept) Экспорт
	Лучший = Неопределено;
	ЛучшийВес = 0;
	Если ТипЗнч(Accept) = Тип("Строка") Тогда
		Для Каждого Диапазон Из СтрРазделить(Accept, ",", Ложь) Цикл
			Кандидат = ФорматДиапазона(Диапазон);
			Если Кандидат <> Неопределено И Кандидат.Вес > ЛучшийВес Тогда
				Лучший = Кандидат.Формат;
				ЛучшийВес = Кандидат.Вес;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ?(Лучший = Неопределено, ФорматПоУмолчанию(), Лучший);
КонецФункции

// Возвращает значение заголовка Content-Type ответа.
//
// Параметры:
//   Формат - Структура, Неопределено - формат выдачи (см. ВыбратьФормат); Неопределено - text 0.0.4.
//
// Возвращаемое значение:
//   Строка - значение заголовка Content-Type.
Функция ContentType(Формат = Неопределено) Экспорт
	Если Формат = Неопределено Тогда
		Возврат "text/plain; version=0.0.4; charset=utf-8";
	КонецЕсли;

	Возврат Формат.ТипКонтента;
КонецФункции

Функция УпорядочитьМассив(Массив)
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Массив);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	Возврат Список.ВыгрузитьЗначения();
КонецФункции

Функция ЭкранироватьЗначениеЛейбла(Значение)
	Если КодСимволаПереводСтроки = Неопределено Тогда
		КодСимволаПереводСтроки = 10;
	КонецЕсли;
	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	
	Результат = Значение;
	Результат = СтрЗаменить(Результат, "\", "\\");
	Результат = СтрЗаменить(Результат, Символ(КодСимволаПереводСтроки), "\n");
	Результат = СтрЗаменить(Результат, """", "\""");
	
	Возврат Результат;
КонецФункции

Функция СтрокаЛейблов(Лейблы, Формат = Неопределено)
	Части = ЧастиЛейблов(Лейблы, Формат);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "{" + СтрСоединить(Части, ",") + "}";
КонецФункции

// Возвращает пары имя="значение" лейблов по возрастанию строк.
//
// Параметры:
//   Лейблы - Соответствие - лейблы.
//   Формат - Структура, Неопределено - формат выдачи: имена лейблов экранируются по его схеме;
//     Неопределено - имена как есть.
//
// Возвращаемое значение:
//   Массив из Строка - пары лейблов.
Функция ЧастиЛейблов(Лейблы, Формат)
	Части = Новый Массив;
	Если Лейблы = Неопределено ИЛИ НЕ ТипЗнч(Лейблы) = Тип("Соответствие") Тогда
		Возврат Части;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Лейблы Цикл
		ЗначениеЛейбла = КлючИЗначение.Значение;
		// Новый ОписаниеТипов на каждый лейбл заметно замедляет выдачу, а значения почти всегда строки
		Если ТипЗнч(ЗначениеЛейбла) <> Тип("Строка") Тогда
			ЗначениеЛейбла = ПривестиКСтроке(Новый ОписаниеТипов("Строка"), ЗначениеЛейбла, "");
		КонецЕсли;

		Экр = ЭкранироватьЗначениеЛейбла(ЗначениеЛейбла);
		Части.Добавить(ИмяВВыдаче(КлючИЗначение.Ключ, Формат, Ложь) + "=""" + Экр + """");
	КонецЦикла;

	Возврат УпорядочитьМассив(Части);
КонецФункции

Функция СтрокаСэмпла(ИмяСэмпла, Лейблы, Значение, Формат = Неопределено)
	Имя = ИмяВВыдаче(ИмяСэмпла, Формат, Истина);
	Части = ЧастиЛейблов(Лейблы, Формат);
	Если СтрНачинаетсяС(Имя, """") Тогда
		// Имя UTF-8 в кавычках выводится первым элементом в фигурных скобках
		Части.Вставить(0, Имя);
		Имя = "";
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат Имя + " " + ФорматЧисла(Значение);
	КонецЕсли;

	Возврат Имя + "{" + СтрСоединить(Части, ",") + "} " + ФорматЧисла(Значение);
КонецФункции

Функция ФорматЧисла(Значение)
	Значение = ПривестиКЧислуСэмпла(Значение, 0);
	Стр = Формат(Значение,"ЧРД=.; ЧН=0; ЧГ=0");
	Возврат Стр;
КонецФункции

Функция ЗначениеНеопределено(Значение)
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Неопределено") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция ПолучитьЗначение(Объект, Ключ, ЗначениеПоУмолчанию)
	Если Объект = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Полученное = Неопределено;
	
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(Ключ) Тогда
			Полученное = Объект[Ключ];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Полученное = Объект.Получить(Ключ);
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеНеопределено(Полученное) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Полученное;
КонецФункции

Функция ПривестиКСтроке(ОписаниеСтроки, Значение, ЗначениеПоУмолчанию)
	
	Приведенное = ОписаниеСтроки.ПривестиЗначение(Значение);
	
	Если Приведенное = Неопределено ИЛИ ТипЗнч(Приведенное) <> Тип("Строка") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Приведенное;
КонецФункции

Функция ПривестиКЧислуСэмпла(Значение, ЗначениеПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	
	Приведенное = ОписаниеЧисла.ПривестиЗначение(Значение);
	
	Если Приведенное = Неопределено ИЛИ ТипЗнч(Приведенное) <> Тип("Число") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Приведенное;
КонецФункции

Функция ОбработатьСэмплБакета(С, Лейблы, БакетыЧисла, ТекущийБакетПлюсInf)
	Ле = Лейблы.Получить("le");
	Если Ле = "+Inf" Тогда
		Возврат С;
	КонецЕсли;
	
	БакетыЧисла.Вставить(ЧисловаяГраница(Ле), С);

	Возврат ТекущийБакетПлюсInf;
КонецФункции

// Возвращает границу бакета как число: PrometheusMetrics передаёт le строкой ("0.5").
//
// Параметры:
//   Ле - Число, Строка - значение лейбла le.
//
// Возвращаемое значение:
//   Число - граница бакета; нераспознанная граница считается нулевой.
Функция ЧисловаяГраница(Ле)
	Возврат ПривестиКЧислуСэмпла(Ле, 0);
КонецФункции

// Возвращает квантиль сэмпла summary. Поле Квантиль необязательное: коллекторы с Collect() могут
// задавать квантиль только лейблом quantile.
//
// Параметры:
//   Сэмпл - Структура, Соответствие - сэмпл summary.
//
// Возвращаемое значение:
//   Число, Неопределено - квантиль; Неопределено, если это не сэмпл квантиля.
Функция КвантильСэмпла(Сэмпл)
	Квантиль = ПолучитьЗначение(Сэмпл, "Квантиль", Неопределено);
	Если Квантиль <> Неопределено Тогда
		Возврат Квантиль;
	КонецЕсли;

	Лейблы = ПолучитьЗначение(Сэмпл, "Лейблы", Неопределено);
	Если ТипЗнч(Лейблы) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Лейблы.Получить("quantile");
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПривестиКЧислуСэмпла(Значение, 0);
КонецФункции

// Разбивает сэмплы семейства на серии: в серию входят сэмплы с одинаковыми лейблами,
// не считая служебного лейбла (le у гистограммы, quantile у резюме).
//
// Параметры:
//   Сэмплы - Массив из Структура - сэмплы семейства.
//   СлужебныйЛейбл - Строка - лейбл, который не участвует в ключе серии.
//
// Возвращаемое значение:
//   Массив из Массив - сэмплы серий в порядке первого появления серии.
Функция РазбитьНаСерии(Сэмплы, СлужебныйЛейбл)
	Серии = Новый Массив;
	ИндексыСерий = Новый Соответствие;
	Для Каждого С Из Сэмплы Цикл
		Лейблы = ПолучитьЗначение(С, "Лейблы", Новый Соответствие);
		КлючСерии = КлючСерии(Лейблы, СлужебныйЛейбл);
		Индекс = ИндексыСерий.Получить(КлючСерии);
		Если Индекс = Неопределено Тогда
			Индекс = Серии.Количество();
			Серии.Добавить(Новый Массив);
			ИндексыСерий.Вставить(КлючСерии, Индекс);
		КонецЕсли;

		Серии[Индекс].Добавить(С);
	КонецЦикла;

	Возврат Серии;
КонецФункции

Функция КлючСерии(Лейблы, СлужебныйЛейбл)
	ЛейблыСерии = Новый Соответствие;
	Если ТипЗнч(Лейблы) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Лейблы Цикл
			Если КлючИЗначение.Ключ <> СлужебныйЛейбл Тогда
				ЛейблыСерии.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрокаЛейблов(ЛейблыСерии);
КонецФункции

Процедура ДобавитьВсе(Приемник, Источник)
	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;
КонецПроцедуры

// Упорядочивает сэмплы histogram. Каждая серия выводится целиком: бакеты по возрастанию le,
// бакет +Inf, _sum, _count.
//
// Параметры:
//   Сэмплы - Массив из Структура - сэмплы семейства.
//   ИмяБазовое - Строка - имя семейства.
//
// Возвращаемое значение:
//   Массив из Структура - упорядоченные сэмплы.
Функция СортироватьСэмплыГистограммы(Сэмплы, ИмяБазовое)
	Результат = Новый Массив;
	Для Каждого СэмплыСерии Из РазбитьНаСерии(Сэмплы, "le") Цикл
		ДобавитьВсе(Результат, СортироватьСэмплыСерииГистограммы(СэмплыСерии, ИмяБазовое));
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СортироватьСэмплыСерииГистограммы(Сэмплы, ИмяБазовое)
	БакетыЧисла = Новый Соответствие;
	БакетПлюсInf = Неопределено;
	Сумма = Неопределено;
	Количество = Неопределено;
	Для Каждого С Из Сэмплы Цикл
		ИмяС = ПолучитьЗначение(С, "ИмяСэмпла", ИмяБазовое);
		
		Если СтрЗаканчиваетсяНа(ИмяС, "_bucket") Тогда
			Лейблы = ПолучитьЗначение(С, "Лейблы", Новый Соответствие);
			БакетПлюсInf = ОбработатьСэмплБакета(С, Лейблы, БакетыЧисла, БакетПлюсInf);
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(ИмяС, "_sum") Тогда
			Сумма = С;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(ИмяС, "_count") Тогда
			Количество = С;
		КонецЕсли;
	КонецЦикла;
	
	ЧисловыеГраницы = Новый Массив;
	Для Каждого КлючИЗначение Из БакетыЧисла Цикл
		ЧисловыеГраницы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	ЧисловыеГраницы = УпорядочитьМассив(ЧисловыеГраницы);
	Результат = Новый Массив;
	
	Для Каждого Гр Из ЧисловыеГраницы Цикл
		Результат.Добавить(БакетыЧисла.Получить(Гр));
	КонецЦикла;
	
	Если БакетПлюсInf <> Неопределено Тогда
		Результат.Добавить(БакетПлюсInf);
	КонецЕсли;
	
	Если Сумма <> Неопределено Тогда
		Результат.Добавить(Сумма);
	КонецЕсли;
	
	Если Количество <> Неопределено Тогда
		Результат.Добавить(Количество);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Упорядочивает сэмплы summary. Каждая серия выводится целиком: квантили по возрастанию,
// _sum, _count.
//
// Параметры:
//   Сэмплы - Массив из Структура - сэмплы семейства.
//   ИмяБазовое - Строка - имя семейства.
//
// Возвращаемое значение:
//   Массив из Структура - упорядоченные сэмплы.
Функция СортироватьСэмплыРезюме(Сэмплы, ИмяБазовое)
	Результат = Новый Массив;
	Для Каждого СэмплыСерии Из РазбитьНаСерии(Сэмплы, "quantile") Цикл
		ДобавитьВсе(Результат, СортироватьСэмплыСерииРезюме(СэмплыСерии, ИмяБазовое));
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СортироватьСэмплыСерииРезюме(Сэмплы, ИмяБазовое)
	КвантилиСписок = Новый Массив;
	Сумма = Неопределено;
	Количество = Неопределено;
	
	Для Каждого С Из Сэмплы Цикл
		ИмяС = ПолучитьЗначение(С, "ИмяСэмпла", ИмяБазовое);
		Кв = КвантильСэмпла(С);
		Если Кв <> Неопределено Тогда
			КвантилиСписок.Добавить(Новый Структура("Сэмпл, Квантиль", С, Кв));
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(ИмяС, "_sum") Тогда
			Сумма = С;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(ИмяС, "_count") Тогда
			Количество = С;
		КонецЕсли;
	КонецЦикла;
	
	Для i = 0 По КвантилиСписок.ВГраница() - 1 Цикл
		Для j = i + 1 По КвантилиСписок.ВГраница() Цикл
			Если КвантилиСписок[i].Квантиль > КвантилиСписок[j].Квантиль Тогда
				Врем = КвантилиСписок[i];
				КвантилиСписок[i] = КвантилиСписок[j];
				КвантилиСписок[j] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Массив;
	Для Каждого К Из КвантилиСписок Цикл
		Результат.Добавить(К.Сэмпл);
	КонецЦикла;
	
	Если Сумма <> Неопределено Тогда
		Результат.Добавить(Сумма);
	КонецЕсли;
	
	Если Количество <> Неопределено Тогда
		Результат.Добавить(Количество);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ДобавитьСтрокуПомощи(Строки, Имя, Справка, ОткрытыеМетрики)
	Если ПустаяСтрока(Справка) Тогда
		Возврат;
	КонецЕсли;

	СправкаЭкр = СтрЗаменить(Справка, "\", "\\");
	СправкаЭкр = СтрЗаменить(СправкаЭкр, Символ(КодСимволаПереводСтроки), "\n");
	Если ОткрытыеМетрики Тогда
		СправкаЭкр = СтрЗаменить(СправкаЭкр, """", "\""");
	КонецЕсли;

	Строки.Добавить("# HELP " + Имя + " " + СправкаЭкр);

КонецПроцедуры

// Сериализует семейства в формат выдачи. Семейства выводятся по возрастанию имени, сэмплы
// histogram и summary - сериями.
//
// Параметры:
//   Семейства - Массив - семейства метрик (см. docs/api/Модули/PrometheusTextFormat.md).
//   Формат - Структура, Неопределено - формат выдачи (см. ВыбратьФормат); Неопределено - text 0.0.4.
//
// Возвращаемое значение:
//   Строка - выдача.
Функция Сериализовать(Семейства, Формат = Неопределено) Экспорт
	Если Формат = Неопределено Тогда
		Формат = ФорматПоУмолчанию();
	КонецЕсли;

	ОткрытыеМетрики = Формат.Тип = "openmetrics";
	Если НЕ ТипЗнч(Семейства) = Тип("Массив") И НЕ ОткрытыеМетрики Тогда
		Возврат "";
	КонецЕсли;

	Если КодСимволаПереводСтроки = Неопределено Тогда
		КодСимволаПереводСтроки = 10;
	КонецЕсли;

	КэшИмен = Новый Соответствие;
	Строки = Новый Массив;
	Для Каждого Семейство Из УпорядоченныеСемейства(Семейства) Цикл
		ДобавитьСтрокиСемейства(Строки, Семейство, Формат);
	КонецЦикла;

	Если ОткрытыеМетрики Тогда
		Строки.Добавить("# EOF");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символ(КодСимволаПереводСтроки)) + Символ(КодСимволаПереводСтроки);
КонецФункции

// Возвращает семейства по возрастанию имени; из семейств с одинаковым именем остается последнее.
//
// Параметры:
//   Семейства - Массив, Неопределено - семейства метрик.
//
// Возвращаемое значение:
//   Массив - семейства.
Функция УпорядоченныеСемейства(Семейства)
	Результат = Новый Массив;
	Если НЕ ТипЗнч(Семейства) = Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	СоответствиеИмяСемейство = Новый Соответствие;
	Для Каждого Семейство Из Семейства Цикл
		Имя = ПолучитьЗначение(Семейство, "Имя", "");
		СоответствиеИмяСемейство.Вставить(Имя, Семейство);
	КонецЦикла;

	Имена = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеИмяСемейство Цикл
		Имена.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Для Каждого Имя Из УпорядочитьМассив(Имена) Цикл
		Результат.Добавить(СоответствиеИмяСемейство.Получить(Имя));
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Добавляет строки семейства: # HELP, # TYPE, в OpenMetrics # UNIT, и строки сэмплов.
//
// Параметры:
//   Строки - Массив из Строка - строки выдачи (мутируется).
//   Семейство - Структура, Соответствие - семейство метрик.
//   Формат - Структура - формат выдачи.
Процедура ДобавитьСтрокиСемейства(Строки, Семейство, Формат)
	ОписаниеСтроки = Новый ОписаниеТипов("Строка");
	Имя = ПривестиКСтроке(ОписаниеСтроки, ПолучитьЗначение(Семейство, "Имя", ""), "");
	ТипМетрики = ПривестиКСтроке(ОписаниеСтроки, ПолучитьЗначение(Семейство, "Тип", "untyped"), "untyped");
	Справка = ПривестиКСтроке(ОписаниеСтроки, ПолучитьЗначение(Семейство, "Справка", ""), "");
	Единица = ПривестиКСтроке(ОписаниеСтроки, ПолучитьЗначение(Семейство, "Единица", ""), "");
	Сэмплы = ПолучитьЗначение(Семейство, "Сэмплы", Новый Массив);
	Если НЕ ТипЗнч(Сэмплы) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Если ТипМетрики = "histogram" Тогда
		Сэмплы = СортироватьСэмплыГистограммы(Сэмплы, Имя);
	КонецЕсли;

	Если ТипМетрики = "summary" Тогда
		Сэмплы = СортироватьСэмплыРезюме(Сэмплы, Имя);
	КонецЕсли;

	ОткрытыеМетрики = Формат.Тип = "openmetrics";
	ИмяСемейства = ИмяСемействаВФормате(Имя, ТипМетрики, ОткрытыеМетрики);
	ИмяВМетаданных = ИмяВВыдаче(ИмяСемейства, Формат, Истина);
	ДобавитьСтрокуПомощи(Строки, ИмяВМетаданных, Справка, ОткрытыеМетрики);
	Строки.Добавить("# TYPE " + ИмяВМетаданных + " " + ТипВФормате(ТипМетрики, ОткрытыеМетрики));
	// OpenMetrics требует, чтобы имя метрики с единицей оканчивалось на эту единицу, а у info и stateset
	// единица должна быть пустой
	Если ОткрытыеМетрики И НЕ ПустаяСтрока(Единица) И ТипМетрики <> "info" И ТипМетрики <> "stateset"
		И СтрЗаканчиваетсяНа(ИмяСемейства, "_" + Единица) Тогда
		Строки.Добавить("# UNIT " + ИмяВМетаданных + " " + Единица);
	КонецЕсли;

	Для Каждого Сэмпл Из Сэмплы Цикл
		ДобавитьСтрокиСэмпла(Строки, Сэмпл, Имя, ТипМетрики, Формат);
	КонецЦикла;
КонецПроцедуры

// Добавляет строку сэмпла, в OpenMetrics - с exemplar и строкой времени создания серии _created.
//
// Параметры:
//   Строки - Массив из Строка - строки выдачи (мутируется).
//   Сэмпл - Структура, Соответствие - сэмпл.
//   Имя - Строка - имя семейства.
//   ТипМетрики - Строка - тип семейства.
//   Формат - Структура - формат выдачи.
Процедура ДобавитьСтрокиСэмпла(Строки, Сэмпл, Имя, ТипМетрики, Формат)
	ОткрытыеМетрики = Формат.Тип = "openmetrics";
	ИмяСэмпла = ПолучитьЗначение(Сэмпл, "ИмяСэмпла", Имя);
	Если ТипЗнч(ИмяСэмпла) <> Тип("Строка") Тогда
		ИмяСэмпла = ПривестиКСтроке(Новый ОписаниеТипов("Строка"), ИмяСэмпла, Имя);
	КонецЕсли;

	ИмяСэмпла = ИмяСэмплаВФормате(ИмяСэмпла, ТипМетрики, ОткрытыеМетрики);
	Лейблы = ПолучитьЗначение(Сэмпл, "Лейблы", Неопределено);
	Значение = ПривестиКЧислуСэмпла(ПолучитьЗначение(Сэмпл, "Значение", 0), 0);
	Если НЕ ОткрытыеМетрики Тогда
		// В text format нет exemplars и _created
		Строки.Добавить(СтрокаСэмпла(ИмяСэмпла, Лейблы, Значение, Формат));
		Возврат;
	КонецЕсли;

	Лейблы = ЛейблыСКаноническимиЧислами(Лейблы, ИмяСэмпла, ТипМетрики);
	СтрокаВыдачи = СтрокаСэмпла(ИмяСэмпла, Лейблы, Значение, Формат);
	Экземпляр = ПолучитьЗначение(Сэмпл, "Экземпляр", Неопределено);
	Если Экземпляр <> Неопределено И ЭкземплярДопустим(ИмяСэмпла, ТипМетрики) Тогда
		СтрокаВыдачи = СтрокаВыдачи + " # " + СтрокаЭкземпляра(Экземпляр, Формат);
	КонецЕсли;

	Строки.Добавить(СтрокаВыдачи);
	Создано = ПолучитьЗначение(Сэмпл, "Создано", Неопределено);
	Если Создано <> Неопределено И ВремяСозданияДопустимо(ИмяСэмпла, ТипМетрики) Тогда
		ИмяСоздания = ИмяСемействаВФормате(Имя, ТипМетрики, Истина) + "_created";
		Строки.Добавить(СтрокаСэмпла(ИмяСоздания, Лейблы, Создано, Формат));
	КонецЕсли;
КонецПроцедуры

// --- Имена и типы в формате выдачи ---

// Возвращает имя семейства в строках # HELP, # TYPE и # UNIT. В OpenMetrics у счетчика нет суффикса
// _total, у info-метрики - суффикса _info. Text format не поддерживает тип info: метрика выводится
// gauge с суффиксом _info.
//
// Параметры:
//   Имя - Строка - имя семейства.
//   ТипМетрики - Строка - тип семейства.
//   ОткрытыеМетрики - Булево - формат OpenMetrics.
//
// Возвращаемое значение:
//   Строка - имя семейства в выдаче.
Функция ИмяСемействаВФормате(Имя, ТипМетрики, ОткрытыеМетрики)
	Если ТипМетрики = "counter" И ОткрытыеМетрики Тогда
		Результат = БезСуффикса(Имя, "_total");
	ИначеЕсли ТипМетрики = "info" Тогда
		База = БезСуффикса(Имя, "_info");
		Результат = ?(ОткрытыеМетрики, База, База + "_info");
	Иначе
		Результат = Имя;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Возвращает имя сэмпла в выдаче: в OpenMetrics у сэмпла счетчика всегда есть суффикс _total, у
// сэмпла info-метрики в обоих форматах - суффикс _info.
//
// Параметры:
//   ИмяСэмпла - Строка - имя сэмпла.
//   ТипМетрики - Строка - тип семейства.
//   ОткрытыеМетрики - Булево - формат OpenMetrics.
//
// Возвращаемое значение:
//   Строка - имя сэмпла.
Функция ИмяСэмплаВФормате(ИмяСэмпла, ТипМетрики, ОткрытыеМетрики)
	Если ТипМетрики = "counter" И ОткрытыеМетрики И НЕ СтрЗаканчиваетсяНа(ИмяСэмпла, "_total") Тогда
		Результат = ИмяСэмпла + "_total";
	ИначеЕсли ТипМетрики = "info" И НЕ СтрЗаканчиваетсяНа(ИмяСэмпла, "_info") Тогда
		Результат = ИмяСэмпла + "_info";
	Иначе
		Результат = ИмяСэмпла;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Возвращает тип в строке # TYPE. Типы info, stateset и unknown есть только в OpenMetrics: в text
// format info и stateset выводятся gauge, unknown - untyped; untyped в OpenMetrics - unknown.
//
// Параметры:
//   ТипМетрики - Строка - тип семейства.
//   ОткрытыеМетрики - Булево - формат OpenMetrics.
//
// Возвращаемое значение:
//   Строка - тип.
Функция ТипВФормате(ТипМетрики, ОткрытыеМетрики)
	Если ОткрытыеМетрики Тогда
		Результат = ?(ТипМетрики = "untyped", "unknown", ТипМетрики);
	ИначеЕсли ТипМетрики = "info" ИЛИ ТипМетрики = "stateset" Тогда
		Результат = "gauge";
	ИначеЕсли ТипМетрики = "unknown" Тогда
		Результат = "untyped";
	Иначе
		Результат = ТипМетрики;
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция БезСуффикса(Имя, Суффикс)
	Если Имя <> Суффикс И СтрЗаканчиваетсяНа(Имя, Суффикс) Тогда
		Возврат Лев(Имя, СтрДлина(Имя) - СтрДлина(Суффикс));
	КонецЕсли;

	Возврат Имя;
КонецФункции

// --- OpenMetrics: exemplars и время создания ---

// Проверяет, что у сэмпла может быть exemplar: в OpenMetrics exemplars есть только у сэмплов
// счетчика и у бакетов гистограммы.
//
// Параметры:
//   ИмяСэмпла - Строка - имя сэмпла.
//   ТипМетрики - Строка - тип семейства.
//
// Возвращаемое значение:
//   Булево - Истина, если exemplar выводится.
Функция ЭкземплярДопустим(ИмяСэмпла, ТипМетрики)
	Возврат ТипМетрики = "counter" ИЛИ ТипМетрики = "histogram" И СтрЗаканчиваетсяНа(ИмяСэмпла, "_bucket");
КонецФункции

// Проверяет, что после сэмпла выводится время создания серии: у счетчика - после сэмпла значения,
// у histogram и summary - после сэмпла _count.
//
// Параметры:
//   ИмяСэмпла - Строка - имя сэмпла.
//   ТипМетрики - Строка - тип семейства.
//
// Возвращаемое значение:
//   Булево - Истина, если после сэмпла выводится _created.
Функция ВремяСозданияДопустимо(ИмяСэмпла, ТипМетрики)
	Если ТипМетрики = "counter" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (ТипМетрики = "histogram" ИЛИ ТипМетрики = "summary") И СтрЗаканчиваетсяНа(ИмяСэмпла, "_count");
КонецФункции

// Возвращает exemplar OpenMetrics: {лейблы} значение [время].
//
// Параметры:
//   Экземпляр - Структура, Соответствие - Лейблы, Значение и необязательное Время (секунды).
//   Формат - Структура - формат выдачи.
//
// Возвращаемое значение:
//   Строка - exemplar.
Функция СтрокаЭкземпляра(Экземпляр, Формат)
	Лейблы = ПолучитьЗначение(Экземпляр, "Лейблы", Новый Соответствие);
	Значение = ПолучитьЗначение(Экземпляр, "Значение", 0);
	Результат = "{" + СтрСоединить(ЧастиЛейблов(Лейблы, Формат), ",") + "} " + ФорматЧисла(Значение);
	Время = ПолучитьЗначение(Экземпляр, "Время", Неопределено);
	Если Время <> Неопределено Тогда
		Результат = Результат + " " + ФорматЧисла(Время);
	КонецЕсли;

	Возврат Результат;
КонецФункции

// --- OpenMetrics: канонические числа в лейблах le и quantile ---

// OpenMetrics требует канонической записи чисел в лейблах le и quantile (1.0, а не 1): это значения
// лейблов, и одно число должно давать одну и ту же серию. В text format запись не меняется, чтобы
// не менять уже собранные серии.
//
// Параметры:
//   Лейблы - Соответствие, Неопределено - лейблы сэмпла.
//   ИмяСэмпла - Строка - имя сэмпла в выдаче.
//   ТипМетрики - Строка - тип семейства.
//
// Возвращаемое значение:
//   Соответствие, Неопределено - копия лейблов с канонической записью le или quantile; исходные лейблы,
//     если менять нечего.
Функция ЛейблыСКаноническимиЧислами(Лейблы, ИмяСэмпла, ТипМетрики)
	Если ТипМетрики = "histogram" И СтрЗаканчиваетсяНа(ИмяСэмпла, "_bucket") Тогда
		ИмяЛейбла = "le";
	ИначеЕсли ТипМетрики = "summary" Тогда
		ИмяЛейбла = "quantile";
	Иначе
		Возврат Лейблы;
	КонецЕсли;

	Если ТипЗнч(Лейблы) <> Тип("Соответствие") Тогда
		Возврат Лейблы;
	КонецЕсли;

	Значение = Лейблы.Получить(ИмяЛейбла);
	Если Значение = Неопределено Тогда
		Возврат Лейблы;
	КонецЕсли;

	Каноническое = КаноническоеЧисло(Значение);
	Если Каноническое = Значение Тогда
		Возврат Лейблы;
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из Лейблы Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Результат.Вставить(ИмяЛейбла, Каноническое);

	Возврат Результат;
КонецФункции

// Порядки экспоненциальной записи %g в Go
// BSLLS:MagicNumber-off

// Возвращает каноническую запись числа OpenMetrics: как %g в Go, с ".0" у числа без дробной части
// и экспоненты (0.0, 0.001, 0.0001, 1e-05, 1.0, 2.5, 100000.0, 1e+06). Запись, которая не является
// десятичным числом (+Inf, экспоненциальная запись из коллектора с Collect()), не меняется.
//
// Параметры:
//   Значение - Строка, Число - значение лейбла le или quantile.
//
// Возвращаемое значение:
//   Строка, Произвольный - каноническая запись или исходное значение.
Функция КаноническоеЧисло(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = ФорматЧисла(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;

	Если НЕ ЭтоДесятичноеЧисло(Текст) Тогда
		Возврат Значение;
	КонецЕсли;

	Знак = "";
	Если СтрНачинаетсяС(Текст, "-") Тогда
		Знак = "-";
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Точка = СтрНайти(Текст, ".");
	Целая = ?(Точка = 0, Текст, Лев(Текст, Точка - 1));
	Дробная = ?(Точка = 0, "", Сред(Текст, Точка + 1));
	Пока СтрНачинаетсяС(Целая, "0") Цикл
		Целая = Сред(Целая, 2);
	КонецЦикла;

	Пока СтрЗаканчиваетсяНа(Дробная, "0") Цикл
		Дробная = Лев(Дробная, СтрДлина(Дробная) - 1);
	КонецЦикла;

	Если Целая = "" И Дробная = "" Тогда
		Возврат "0.0";
	КонецЕсли;

	Если Целая <> "" Тогда
		Порядок = СтрДлина(Целая) - 1;
		Цифры = Целая + Дробная;
	Иначе
		НулиДроби = 0;
		Пока Сред(Дробная, НулиДроби + 1, 1) = "0" Цикл
			НулиДроби = НулиДроби + 1;
		КонецЦикла;

		Порядок = -НулиДроби - 1;
		Цифры = Сред(Дробная, НулиДроби + 1);
	КонецЕсли;

	Если Порядок >= -4 И Порядок < 6 Тогда
		Возврат Знак + ?(Целая = "", "0", Целая) + "." + ?(Дробная = "", "0", Дробная);
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Цифры, "0") Цикл
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЦикла;

	Мантисса = Лев(Цифры, 1) + ?(СтрДлина(Цифры) > 1, "." + Сред(Цифры, 2), "");
	МодульПорядка = ?(Порядок < 0, -Порядок, Порядок);
	Показатель = ?(МодульПорядка < 10, "0", "") + Формат(МодульПорядка, "ЧГ=0");

	Возврат Знак + Мантисса + "e" + ?(Порядок < 0, "-", "+") + Показатель;
КонецФункции

// BSLLS:MagicNumber-on

// Проверяет запись вида [-]цифры[.цифры].
Функция ЭтоДесятичноеЧисло(Текст)
	Начало = ?(СтрНачинаетсяС(Текст, "-"), 2, 1);
	Точка = СтрНайти(Текст, ".");
	Если СтрДлина(Текст) < Начало ИЛИ Точка = Начало ИЛИ Точка = СтрДлина(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = Начало По СтрДлина(Текст) Цикл
		Если Позиция <> Точка И СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

// --- Согласование формата (Prometheus Content Negotiation) ---

Функция НовыйФормат(ТипФормата, Версия, Экранирование)
	ПоУмолчанию = "underscores";
	Схема = ?(ТипЗнч(Экранирование) = Тип("Строка"), НРег(Экранирование), ПоУмолчанию);
	// Имена UTF-8 допустимы только в форматах версии 1.0.0
	Если СтрРазделить(ПоУмолчанию + ",dots,values,allow-utf-8", ",").Найти(Схема) = Неопределено
		ИЛИ Схема = "allow-utf-8" И Версия <> "1.0.0" Тогда
		Схема = ПоУмолчанию;
	КонецЕсли;

	ТипМедиа = ?(ТипФормата = "openmetrics", "application/openmetrics-text", "text/plain");
	ТипКонтента = ТипМедиа + "; version=" + Версия + "; charset=utf-8";
	Если Версия = "1.0.0" ИЛИ Схема <> ПоУмолчанию Тогда
		ТипКонтента = ТипКонтента + "; escaping=" + Схема;
	КонецЕсли;

	Формат = Новый Структура("Тип, Версия, Экранирование", ТипФормата, Версия, Схема);
	Формат.Вставить("ТипКонтента", ТипКонтента);

	Возврат Формат;
КонецФункции

// Возвращает формат, соответствующий диапазону медиа-типов заголовка Accept, и его вес.
//
// Параметры:
//   Диапазон - Строка - медиа-тип и параметры через ";".
//
// Возвращаемое значение:
//   Структура, Неопределено - Формат и Вес; Неопределено, если формат не поддерживается или вес 0.
Функция ФорматДиапазона(Диапазон)
	Части = СтрРазделить(Диапазон, ";");
	Параметры = ПараметрыДиапазона(Части);
	Вес = ВесДиапазона(Параметры.Получить("q"));
	Если Вес <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипМедиа = НРег(СокрЛП(Части[0]));
	Формат = ФорматТипаМедиа(ТипМедиа, Параметры.Получить("version"), Параметры.Получить("escaping"));
	Если Формат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Формат, Вес", Формат, Вес);
КонецФункции

// Возвращает формат для медиа-типа диапазона. Без version OpenMetrics - версии 0.0.1, text - 0.0.4.
//
// Параметры:
//   ТипМедиа - Строка - медиа-тип в нижнем регистре.
//   Версия - Строка, Неопределено - параметр version.
//   Экранирование - Строка, Неопределено - параметр escaping.
//
// Возвращаемое значение:
//   Структура, Неопределено - формат; Неопределено, если медиа-тип или версия не поддерживаются.
Функция ФорматТипаМедиа(ТипМедиа, Версия, Экранирование)
	Если ТипМедиа = "application/openmetrics-text" Тогда
		ТипФормата = "openmetrics";
		ВерсияФормата = ?(Версия = Неопределено, "0.0.1", Версия);
		Поддерживаемые = "0.0.1,1.0.0";
	ИначеЕсли ТипМедиа = "text/plain" Тогда
		ТипФормата = "text";
		ВерсияФормата = ?(Версия = Неопределено, "0.0.4", Версия);
		Поддерживаемые = "0.0.4,1.0.0";
	ИначеЕсли ТипМедиа = "*/*" ИЛИ ТипМедиа = "text/*" Тогда
		Возврат ФорматПоУмолчанию();
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если СтрРазделить(Поддерживаемые, ",").Найти(ВерсияФормата) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НовыйФормат(ТипФормата, ВерсияФормата, Экранирование);
КонецФункции

Функция ПараметрыДиапазона(Части)
	Параметры = Новый Соответствие;
	Для Индекс = 1 По Части.ВГраница() Цикл
		Параметр = Части[Индекс];
		Равно = СтрНайти(Параметр, "=");
		Если Равно > 0 Тогда
			Значение = СтрЗаменить(СокрЛП(Сред(Параметр, Равно + 1)), """", "");
			Параметры.Вставить(НРег(СокрЛП(Лев(Параметр, Равно - 1))), Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Параметры;
КонецФункции

Функция ВесДиапазона(Значение)
	Если Значение = Неопределено Тогда
		Возврат 1;
	КонецЕсли;

	// Нераспознанный вес приводится к 0: диапазон не принимается
	Возврат ПривестиКЧислуСэмпла(Значение, 0);
КонецФункции

// --- Экранирование имен ---

// Возвращает имя метрики или лейбла в выдаче: имя экранируется по схеме формата; при allow-utf-8
// имя вне классического формата берется в кавычки.
//
// Параметры:
//   Имя - Строка - имя.
//   Формат - Структура, Неопределено - формат выдачи; Неопределено - имя как есть.
//   ЭтоМетрика - Булево - имя метрики (двоеточие допустимо) или лейбла.
//
// Возвращаемое значение:
//   Строка - имя в выдаче.
Функция ИмяВВыдаче(Имя, Формат, ЭтоМетрика)
	Если Формат = Неопределено Тогда
		Возврат Имя;
	КонецЕсли;

	Если КэшИмен = Неопределено Тогда
		КэшИмен = Новый Соответствие;
	КонецЕсли;

	Ключ = Формат.Экранирование + ?(ЭтоМетрика, "|metric|", "|label|") + Имя;
	Результат = КэшИмен.Получить(Ключ);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Формат.Экранирование = "allow-utf-8" Тогда
		Результат = ?(ИмяКлассическое(Имя, ЭтоМетрика), Имя, """" + ЭкранироватьЗначениеЛейбла(Имя) + """");
	Иначе
		Результат = ЭкранироватьИмя(Имя, Формат.Экранирование, ЭтоМетрика);
	КонецЕсли;

	КэшИмен.Вставить(Ключ, Результат);

	Возврат Результат;
КонецФункции

// Экранирует имя по схеме Prometheus: underscores - недопустимые символы заменяются на "_" (имя
// классического формата не меняется); dots - "_" на "__", "." на "_dot_", прочие недопустимые на
// "__"; values - имя классического формата не меняется, иначе префикс "U__", "_" на "__",
// недопустимый символ на "_<код символа в hex>_".
//
// Параметры:
//   Имя - Строка - имя.
//   Экранирование - Строка - underscores, dots или values.
//   ЭтоМетрика - Булево - имя метрики (двоеточие допустимо) или лейбла.
//
// Возвращаемое значение:
//   Строка - экранированное имя.
Функция ЭкранироватьИмя(Имя, Экранирование, ЭтоМетрика)
	Если ИмяКлассическое(Имя, ЭтоМетрика) И Экранирование <> "dots" Тогда
		Возврат Имя;
	КонецЕсли;

	Части = Новый Массив;
	Если Экранирование = "values" Тогда
		Части.Добавить("U__");
	КонецЕсли;

	Позиция = 1;
	Пока Позиция <= СтрДлина(Имя) Цикл
		Символ = СимволИмени(Имя, Позиция);
		Части.Добавить(ЭкранированныйСимвол(Символ, Позиция = 1, Экранирование, ЭтоМетрика));
		Позиция = Позиция + СтрДлина(Символ);
	КонецЦикла;

	Возврат СтрСоединить(Части);
КонецФункции

// Коды символов UTF-16 и шестнадцатеричная запись
// BSLLS:MagicNumber-off

// Возвращает символ имени в позиции; символ вне BMP - суррогатной парой UTF-16 целиком.
//
// Параметры:
//   Имя - Строка - имя.
//   Позиция - Число - позиция символа.
//
// Возвращаемое значение:
//   Строка - символ или суррогатная пара.
Функция СимволИмени(Имя, Позиция)
	Если ЭтоСуррогатнаяПара(Имя, Позиция) Тогда
		Возврат Сред(Имя, Позиция, 2);
	КонецЕсли;

	Возврат Сред(Имя, Позиция, 1);
КонецФункции

// Экранирует один символ имени по схеме; цифра в начале имени недопустима.
//
// Параметры:
//   Символ - Строка - символ или суррогатная пара.
//   Первый - Булево - символ первый в имени.
//   Экранирование - Строка - underscores, dots или values.
//   ЭтоМетрика - Булево - имя метрики (двоеточие допустимо) или лейбла.
//
// Возвращаемое значение:
//   Строка - экранированный символ.
Функция ЭкранированныйСимвол(Символ, Первый, Экранирование, ЭтоМетрика)
	Классический = СимволКлассический(Символ, Первый, ЭтоМетрика);
	Если Экранирование = "underscores" Тогда
		Результат = ?(Классический, Символ, "_");
	ИначеЕсли Экранирование = "dots" И Символ = "." Тогда
		Результат = "_dot_";
	ИначеЕсли Символ = "_" ИЛИ Экранирование = "dots" И НЕ Классический Тогда
		Результат = "__";
	ИначеЕсли Классический Тогда
		Результат = Символ;
	Иначе
		Результат = "_" + НРег(ЧислоВШестнадцатеричное(КодСимволаИмени(Символ))) + "_";
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция ИмяКлассическое(Имя, ЭтоМетрика)
	Если Имя = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если НЕ СимволКлассический(Сред(Имя, Позиция, 1), Позиция = 1, ЭтоМетрика) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

// Проверяет символ классического имени: [a-zA-Z_:][a-zA-Z0-9_:]* для метрики, без ":" для лейбла.
//
// Параметры:
//   Символ - Строка - символ или суррогатная пара.
//   Первый - Булево - символ первый в имени.
//   ЭтоМетрика - Булево - имя метрики или лейбла.
//
// Возвращаемое значение:
//   Булево - Истина, если символ допустим в классическом имени.
Функция СимволКлассический(Символ, Первый, ЭтоМетрика)
	Код = КодСимвола(Символ);
	Буква = (Код >= КодСимвола("a") И Код <= КодСимвола("z")) ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"));
	Цифра = Код >= КодСимвола("0") И Код <= КодСимвола("9");

	Возврат СтрДлина(Символ) = 1
		И (Буква ИЛИ Символ = "_" ИЛИ (ЭтоМетрика И Символ = ":") ИЛИ (Цифра И НЕ Первый));
КонецФункции

// Проверяет, что в позиции имени стоит суррогатная пара UTF-16: старший суррогат D800-DBFF и
// младший DC00-DFFF.
//
// Параметры:
//   Имя - Строка - имя.
//   Позиция - Число - позиция старшего суррогата.
//
// Возвращаемое значение:
//   Булево - Истина, если в позиции суррогатная пара.
Функция ЭтоСуррогатнаяПара(Имя, Позиция)
	Если Позиция >= СтрДлина(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Старший = КодСимвола(Имя, Позиция);
	Младший = КодСимвола(Имя, Позиция + 1);

	Возврат Старший >= 55296 И Старший <= 56319 И Младший >= 56320 И Младший <= 57343;
КонецФункции

// Возвращает код символа имени; у суррогатной пары - код символа вне BMP.
//
// Параметры:
//   Символ - Строка - символ или суррогатная пара.
//
// Возвращаемое значение:
//   Число - код символа.
Функция КодСимволаИмени(Символ)
	Если СтрДлина(Символ) = 1 Тогда
		Возврат КодСимвола(Символ);
	КонецЕсли;

	Возврат (КодСимвола(Символ, 1) - 55296) * 1024 + (КодСимвола(Символ, 2) - 56320) + 65536;
КонецФункции

Функция ЧислоВШестнадцатеричное(Число)
	Цифры = "0123456789ABCDEF";
	Остаток = Число;
	Результат = "";
	Пока Остаток > 0 Цикл
		Результат = Сред(Цифры, Остаток % 16 + 1, 1) + Результат;
		Остаток = Цел(Остаток / 16);
	КонецЦикла;

	Возврат ?(Результат = "", "0", Результат);
КонецФункции

// BSLLS:MagicNumber-on