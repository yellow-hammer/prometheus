// BSLLS:ExportVariables-off

// Реестр коллекторов Prometheus.
// В Коллекторы допускаются:
// - структуры метрик (поле Тип: counter, gauge, *_vector и т.д.) - сбор через PrometheusMetrics / PrometheusVec;
// - объекты с методом Collect(), возвращающим массив семейств (Имя, Тип, Справка, Сэмплы).
Перем Коллекторы Экспорт;

// BSLLS:ExportVariables-on

Процедура ПриСозданииОбъекта()
	Коллекторы = Новый Массив;
КонецПроцедуры

// Зарегистрировать коллектор.
//
// Параметры:
//   Коллектор - Структура, Объект - структура метрики (поле Тип) либо объект с методом Collect().
//
// Возвращаемое значение:
//   Булево - Истина; Ложь, если этот коллектор уже зарегистрирован или в реестре есть метрика с тем же
//     именем и такими же константными лейблами либо с тем же именем и другим типом.
Функция Register(Коллектор) Экспорт
	Если Коллекторы.Найти(Коллектор) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоСтруктураМетрики(Коллектор) Тогда
		Для Каждого Зарегистрированный Из Коллекторы Цикл
			Если ЭтоСтруктураМетрики(Зарегистрированный) И МетрикиКонфликтуют(Зарегистрированный, Коллектор) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Коллекторы.Добавить(Коллектор);

	Возврат Истина;
КонецФункции

// Снять регистрацию коллектора.
//
// Параметры:
//   Коллектор - Объект - зарегистрированный ранее коллектор.
//
// Возвращаемое значение:
//   Булево - Истина при успехе, Ложь если коллектор не был зарегистрирован.
Функция Unregister(Коллектор) Экспорт
	Индекс = Коллекторы.Найти(Коллектор);
	Если Индекс = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Коллекторы.Удалить(Индекс);

	Возврат Истина;
КонецФункции

// Собрать метрики со всех зарегистрированных коллекторов.
//
// Возвращаемое значение:
//   Массив из Структура - семейства метрик (Имя, Тип, Справка, Сэмплы); семейства с одинаковым именем
//     объединены в одно.
Функция Gather() Экспорт
	ВсеСемейства = Новый Массив;
	Для Каждого Коллектор Из Коллекторы Цикл
		Если ЭтоСтруктураМетрики(Коллектор) Тогда
			РезультатСэмплов = Новый Массив;
			Если ЭтоВекторМетрик(Коллектор.Тип) Тогда
				PrometheusVec.СобратьВектор(Коллектор, РезультатСэмплов);
			Иначе
				PrometheusMetrics.СобратьКоллектор(Коллектор, РезультатСэмплов);
			КонецЕсли;
			Семейства = СформироватьСемействаИзСэмплов(РезультатСэмплов);
			Для Каждого Семейство Из Семейства Цикл
				ВсеСемейства.Добавить(Семейство);
			КонецЦикла;
		Иначе
			Семейства = Коллектор.Collect();
			Для Каждого Семейство Из Семейства Цикл
				ВсеСемейства.Добавить(Семейство);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат ОбъединитьСемействаПоИмени(ВсеСемейства);
КонецФункции

Функция ЭтоСтруктураМетрики(Коллектор)
	Возврат ТипЗнч(Коллектор) = Тип("Структура") И Коллектор.Свойство("Тип");
КонецФункции

// Метрики с одним именем выводятся одним семейством. Допустимы только метрики одного типа с разными
// константными лейблами: при одинаковых лейблах серии совпадут, и Prometheus отбросит одну из них.
Функция МетрикиКонфликтуют(Первая, Вторая)
	Если НЕ Первая.Свойство("Имя") ИЛИ НЕ Вторая.Свойство("Имя") ИЛИ Первая.Имя <> Вторая.Имя Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат БазовыйТип(Первая.Тип) <> БазовыйТип(Вторая.Тип)
		ИЛИ ОдинаковыеЛейблы(КонстантныеЛейблы(Первая), КонстантныеЛейблы(Вторая));
КонецФункции

Функция БазовыйТип(ТипКоллектора)
	Суффикс = "_vector";
	Если СтрЗаканчиваетсяНа(ТипКоллектора, Суффикс) Тогда
		Возврат Лев(ТипКоллектора, СтрДлина(ТипКоллектора) - СтрДлина(Суффикс));
	КонецЕсли;

	Возврат ТипКоллектора;
КонецФункции

Функция КонстантныеЛейблы(Метрика)
	Если Метрика.Свойство("КонстантныеЛейблы") И ТипЗнч(Метрика.КонстантныеЛейблы) = Тип("Соответствие") Тогда
		Возврат Метрика.КонстантныеЛейблы;
	КонецЕсли;

	Возврат Новый Соответствие;
КонецФункции

Функция ОдинаковыеЛейблы(Первые, Вторые)
	Если Первые.Количество() <> Вторые.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Первые Цикл
		Значение = Вторые.Получить(КлючИЗначение.Ключ);
		Если Значение = Неопределено ИЛИ Строка(Значение) <> Строка(КлючИЗначение.Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

// Семейства с одинаковым именем (метрики с разными константными лейблами, коллекторы с Collect())
// объединяются в одно: сериализатор из семейств с одним именем выводит только последнее.
//
// Параметры:
//   Семейства - Массив - семейства всех коллекторов.
//
// Возвращаемое значение:
//   Массив - семейства с уникальными именами в порядке первого появления.
Функция ОбъединитьСемействаПоИмени(Семейства)
	Имена = Новый Массив;
	ГруппыПоИмени = Новый Соответствие;
	Для Каждого Семейство Из Семейства Цикл
		Имя = ПолеСемейства(Семейство, "Имя");
		Если Имя = Неопределено Тогда
			Имя = "";
		КонецЕсли;

		Группа = ГруппыПоИмени.Получить(Имя);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ГруппыПоИмени.Вставить(Имя, Группа);
			Имена.Добавить(Имя);
		КонецЕсли;

		Группа.Добавить(Семейство);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Группа = ГруппыПоИмени.Получить(Имя);
		Результат.Добавить(?(Группа.Количество() = 1, Группа[0], ОбъединенноеСемейство(Группа)));
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Копирует первое семейство группы и собирает сэмплы всех семейств в новый массив, чтобы не менять
// массивы Сэмплы, которые вернули коллекторы.
Функция ОбъединенноеСемейство(Группа)
	Первое = Группа[0];
	Если ТипЗнч(Первое) = Тип("Соответствие") Тогда
		Объединенное = Новый Соответствие;
	Иначе
		Объединенное = Новый Структура;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Первое Цикл
		Объединенное.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Сэмплы = Новый Массив;
	Для Каждого Семейство Из Группа Цикл
		СэмплыСемейства = ПолеСемейства(Семейство, "Сэмплы");
		Если ТипЗнч(СэмплыСемейства) = Тип("Массив") Тогда
			Для Каждого Сэмпл Из СэмплыСемейства Цикл
				Сэмплы.Добавить(Сэмпл);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Объединенное.Вставить("Сэмплы", Сэмплы);

	Возврат Объединенное;
КонецФункции

Функция ПолеСемейства(Семейство, Поле)
	Если ТипЗнч(Семейство) = Тип("Соответствие") Тогда
		Возврат Семейство.Получить(Поле);
	КонецЕсли;

	Если ТипЗнч(Семейство) = Тип("Структура") И Семейство.Свойство(Поле) Тогда
		Возврат Семейство[Поле];
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

Функция ЭтоВекторМетрик(ТипКоллектора)
	Возврат ТипКоллектора = "counter_vector" Или ТипКоллектора = "gauge_vector"
		Или ТипКоллектора = "histogram_vector" Или ТипКоллектора = "summary_vector";
КонецФункции

Функция СформироватьСемействаИзСэмплов(Сэмплы)
	СоответствиеСемейств = Новый Соответствие;
	Для Каждого Сэмпл Из Сэмплы Цикл
		Имя = Сэмпл.Имя;
		Семейство = СоответствиеСемейств.Получить(Имя);
		Если Семейство = Неопределено Тогда
			Семейство = Новый Структура;
			Семейство.Вставить("Имя", Имя);
			Семейство.Вставить("Тип", Сэмпл.Тип);
			Семейство.Вставить("Справка", Сэмпл.Справка);
			Семейство.Вставить("Сэмплы", Новый Массив);
			СоответствиеСемейств.Вставить(Имя, Семейство);
		КонецЕсли;

		СэмплДляСемейства = Новый Структура(
			"ИмяСэмпла, Лейблы, Значение",
			Сэмпл.ИмяСэмпла, Сэмпл.Лейблы, Сэмпл.Значение);
		Если Сэмпл.Свойство("Квантиль") Тогда
			СэмплДляСемейства.Вставить("Квантиль", Сэмпл.Квантиль);
		КонецЕсли;

		Если Сэмпл.Свойство("ВерхняяГраница") Тогда
			СэмплДляСемейства.Вставить("ВерхняяГраница", Сэмпл.ВерхняяГраница);
		КонецЕсли;

		Семейство.Сэмплы.Добавить(СэмплДляСемейства);
	КонецЦикла;

	Семейства = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеСемейств Цикл
		Семейства.Добавить(КлючИЗначение.Значение);
	КонецЦикла;

	Возврат Семейства;
КонецФункции
